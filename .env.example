# Copy to .env and replace the value with a password you generate locally.
# .env is git-ignored; never commit a real password.
#
#   pwsh -c "[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes([Guid]::NewGuid())) + 'aA1!'"
#
# SQL Server requires at least 8 characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=replace-me-with-a-locally-generated-password
